<view class="page">
  <view class="heading">
    <view>
      <view class="eyebrow">LOCAL VOICE COMPANION</view>
      <view class="title">听见你的每一句</view>
      <view class="subtitle">本地识别，电脑同步，屏幕回应。</view>
    </view>
    <button class="connection-toggle" bindtap="editConnection" aria-label="编辑电脑连接">
      <view class="connection-dot {{connected ? 'is-connected' : ''}}"></view>
      <text>{{connected ? '已连接' : '连接'}}</text>
    </button>
  </view>

  <view wx:if="{{showConnection}}" class="panel connection-panel">
    <view class="panel-heading">
      <view class="panel-title">连接你的电脑</view>
      <button class="quiet small-button" bindtap="scanPairing">扫码配对</button>
    </view>
    <view class="field">
      <view class="field-label">电脑服务地址</view>
      <input class="input" value="{{address}}" data-field="address" bindinput="inputConnection" placeholder="ws://192.168.1.100:8765" placeholder-class="placeholder" maxlength="1024" cursor-spacing="24" aria-label="电脑 WebSocket 地址" />
    </view>
    <view class="field">
      <view class="field-label">设备标识</view>
      <input class="input" value="{{deviceId}}" data-field="deviceId" bindinput="inputConnection" placeholder="与开发板配置保持一致" placeholder-class="placeholder" maxlength="40" cursor-spacing="24" aria-label="设备标识" />
    </view>
    <view class="field">
      <view class="field-label">配对口令</view>
      <input class="input" password value="{{token}}" data-field="token" bindinput="inputConnection" placeholder="由电脑本地生成" placeholder-class="placeholder" maxlength="256" cursor-spacing="24" aria-label="配对口令" />
    </view>
    <view class="option-row remember-row">
      <text>在这台手机记住连接</text>
      <switch checked="{{remember}}" bindchange="rememberChanged" aria-label="记住连接信息" />
    </view>
    <view class="connection-actions">
      <button class="primary" bindtap="connect">{{connected ? '重新连接' : '连接电脑'}}</button>
      <button wx:if="{{connectionState !== 'disconnected' && connectionState !== 'paused'}}" class="secondary" bindtap="disconnect">断开</button>
    </view>
    <view class="caption">手机和电脑需在同一网段。配对口令只保存在当前手机，不要分享连接二维码。</view>
  </view>

  <view wx:if="{{errorText}}" class="message error" aria-role="alert">{{errorText}}</view>
  <view wx:if="{{notice}}" class="message notice">{{notice}}</view>

  <view class="tabs" aria-role="tablist" aria-label="功能切换">
    <button class="tab {{tab === 'live' ? 'active' : ''}}" data-tab="live" bindtap="selectTab" aria-role="tab" aria-selected="{{tab === 'live'}}">语音字幕</button>
    <button class="tab {{tab === 'settings' ? 'active' : ''}}" data-tab="settings" bindtap="selectTab" aria-role="tab" aria-selected="{{tab === 'settings'}}">屏幕设置</button>
  </view>

  <view wx:if="{{tab === 'live'}}">
    <view class="listening-panel {{connected && state === 'recording' ? 'is-listening' : ''}}">
      <view class="companion {{state === 'processing' ? 'thinking' : ''}}" aria-hidden="true">
        <view class="face">
          <view class="eyes"><view class="eye"></view><view class="eye"></view></view>
          <view class="mouth {{connected && state === 'recording' ? 'speaking' : ''}}"></view>
        </view>
      </view>
      <view class="state-copy">
        <view class="state-title">{{stateTitle}}</view>
        <view class="state-description">{{stateMessage}}</view>
      </view>
      <view class="level-track" aria-label="实时音量 {{level}}%"><view class="level-fill" style="width:{{level}}%;"></view></view>
      <view class="live-footer">
        <view class="live-indicator"><view class="status-dot {{connected ? 'online' : ''}}"></view>{{connectionTitle}}</view>
        <text wx:if="{{connected}}">{{ready ? '模型就绪' : '模型未就绪'}}</text>
      </view>
    </view>

    <view class="section-heading">
      <view class="panel-title">最近的对话</view>
      <view class="caption">{{groups.length}} 段录音</view>
    </view>
    <view wx:if="{{lastTiming}}" class="timing">{{lastTiming}}</view>
    <view wx:if="{{historyDisplayHint}}" class="caption history-upgrade">{{historyDisplayHint}}</view>
    <view wx:if="{{!groups.length}}" class="empty-state">
      <view class="empty-symbol">Aa</view>
      <view class="empty-title">第一句话，从按下 BOOT 开始</view>
      <view class="caption">按住说话，松开结束。停顿会自动断句，识别后的字幕会出现在这里和 OLED 上。</view>
    </view>
    <view wx:for="{{groups}}" wx:key="id" class="panel transcript-card">
      <view class="transcript-heading">
        <view class="record-label"><view class="record-dot {{item.active ? 'recording' : ''}}"></view><text>{{item.active ? '本次录音' : '录音'}} · {{item.shortId}}</text></view>
        <button class="quiet small-button" data-id="{{item.id}}" bindtap="copyTranscript" disabled="{{!item.hasText}}">复制</button>
      </view>
      <view wx:for="{{item.segments}}" wx:for-item="segment" wx:key="key" class="segment">
        <view class="segment-text {{!segment.final ? 'partial' : ''}}" user-select><text wx:for="{{segment.cueTokens}}" wx:for-item="tokenPart" wx:key="start" class="{{tokenPart.highlight ? 'text-cue' : ''}} {{tokenPart.negated ? 'cue-negated' : ''}}">{{tokenPart.text}}</text><text wx:if="{{!segment.cueTokens.length}}">{{segment.corrected_text || segment.text || '…'}}</text></view>
        <view class="segment-meta">
          <text>{{segment.seconds}}s</text>
          <text wx:if="{{!segment.final}}" class="partial-label">实时字幕 · 待确认</text>
          <text wx:if="{{segment.emotionText}}" class="emotion-label">声音 · {{segment.emotionText}}</text>
          <text wx:if="{{segment.cueCount}}">文字 · {{segment.cueCount}} 处线索</text>
          <text wx:if="{{segment.final}}" class="source-tag">{{segment.corrected_text ? '校对版' : '原始 ASR'}}</text>
        </view>
        <view wx:if="{{segment.final}}" class="history-actions">
          <button class="quiet history-action" data-key="{{segment.key}}" bindtap="openCorrection" disabled="{{historyEditor.saving}}">校对</button>
          <button wx:if="{{segment.corrected_text}}" class="quiet history-action" data-key="{{segment.key}}" bindtap="toggleOriginal">{{segment.originalOpen ? '收起原文' : '对照原文'}}</button>
          <button class="quiet history-action" data-key="{{segment.key}}" data-source="original" bindtap="displayHistory" loading="{{historyDisplayPending && historyDisplayKey === segment.key && historyDisplaySource === 'original'}}" disabled="{{!connected || !historyDisplaySupported || historyDisplayPending || state === 'offline' || state === 'recording' || state === 'processing'}}">推送原始</button>
          <button class="quiet history-action" data-key="{{segment.key}}" data-source="corrected" bindtap="displayHistory" loading="{{historyDisplayPending && historyDisplayKey === segment.key && historyDisplaySource === 'corrected'}}" disabled="{{!segment.corrected_text || !connected || !historyDisplaySupported || historyDisplayPending || state === 'offline' || state === 'recording' || state === 'processing'}}">推送校对</button>
        </view>
        <view wx:if="{{segment.originalOpen && segment.corrected_text}}" class="original-comparison"><view class="caption">原始识别文字 · 保留不变</view><text user-select>{{segment.text}}</text></view>
        <view wx:if="{{historyDisplayKey === segment.key && historyDisplayStatus}}" class="quality-note">{{historyDisplayStatus}}</view>
        <view wx:if="{{segment.qualityNote}}" class="quality-note">{{segment.qualityNote}}</view>
        <button class="emotion-toggle" data-key="{{segment.key}}" bindtap="toggleEmotionDetails" aria-expanded="{{segment.detailsOpen}}">情绪详情 <text>{{segment.detailsOpen ? '收起' : '展开'}}</text></button>
        <view wx:if="{{segment.detailsOpen}}" class="emotion-details">
          <view class="detail-heading"><text class="source-tag">声音模型</text><text>{{segment.emotionText || '等待声音分析'}}</text></view>
          <view wx:if="{{segment.emotion && segment.emotion.event}}" class="detail-copy">声音事件：{{segment.emotion.event}}</view>
          <view wx:if="{{segment.qualityDetail}}" class="detail-copy">音频测量：{{segment.qualityDetail}}</view>
          <view wx:if="{{segment.candidateText}}" class="detail-copy">参考候选：{{segment.candidateText}}（未校准，供参考；不是置信率）</view>
          <view class="detail-heading text-source"><text class="source-tag">文字规则</text><text>{{segment.cueCount ? '词语、否定与程度' : '未找到词典内的明确线索'}}</text></view>
          <view wx:for="{{segment.detailCues}}" wx:for-item="cue" wx:key="start" class="cue-detail">
            <view>“{{cue.text}}” · {{cue.label}}词</view>
            <view class="detail-copy">{{cue.negation}} · 程度{{cue.degree}}</view>
            <view class="detail-copy">{{cue.reason}}</view>
          </view>
          <view wx:if="{{segment.cuesLimited}}" class="detail-copy">{{segment.cueLimitNote}}</view>
          <view class="detail-note">声音情绪来自原录音；文字线索分析当前显示的{{segment.corrected_text ? '校对版' : '识别文字'}}，不会改写声音标签。{{!segment.final ? '实时字幕仍会修订。' : ''}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{groups.length}}" class="footnote">声音标签来自本地语音模型；高亮来自本地文字规则。它们是参考线索，不用于判断心理状态。</view>
  </view>

  <view wx:if="{{tab === 'settings'}}">
    <view class="panel applied-panel">
      <view class="eyebrow">OLED · 128 × 64</view>
      <view class="panel-title">设备当前设置</view>
      <view class="applied-summary">{{appliedSummary}}</view>
      <view class="settings-status {{pending ? 'pending' : ''}}">{{settingsStatus}}</view>
    </view>
    <view class="panel settings-panel">
      <view class="option-row">
        <view><view class="field-label">字体大小</view><view class="caption">字号越大，每页能显示的文字越少</view></view>
        <picker mode="selector" range="{{fontOptions}}" value="{{draft.font_scale - 1}}" bindchange="fontChanged" disabled="{{pending}}">
          <view class="picker-value">{{draft.font_scale}} 倍 <text class="chevron">⌄</text></view>
        </picker>
      </view>
      <view class="option-row divided">
        <view class="field-label">文字展示</view>
        <picker mode="selector" range="{{modeOptions}}" value="{{modeIndex}}" bindchange="modeChanged" disabled="{{pending}}">
          <view class="picker-value">{{modeOptions[modeIndex]}} <text class="chevron">⌄</text></view>
        </picker>
      </view>
      <view class="slider-field divided">
        <view class="option-row"><view class="field-label">翻页停留</view><text class="setting-value">{{draftPageSeconds}} 秒</text></view>
        <slider min="500" max="10000" step="500" value="{{draft.page_ms}}" data-field="page_ms" bindchange="sliderChanged" disabled="{{pending}}" aria-label="翻页停留毫秒数" />
      </view>
      <view class="slider-field divided">
        <view class="option-row"><view class="field-label">滚动速度</view><text class="setting-value">{{draft.scroll_speed}} 像素/秒</text></view>
        <slider min="5" max="60" step="1" value="{{draft.scroll_speed}}" data-field="scroll_speed" bindchange="sliderChanged" disabled="{{pending}}" aria-label="滚动速度" />
      </view>
      <view class="slider-field divided">
        <view class="option-row"><view class="field-label">屏幕亮度</view><text class="setting-value">{{draft.brightness}} / 255</text></view>
        <slider min="1" max="255" step="1" value="{{draft.brightness}}" data-field="brightness" bindchange="sliderChanged" disabled="{{pending}}" aria-label="屏幕亮度" />
      </view>
      <view class="option-row divided">
        <view><view class="field-label">角色动画</view><view class="caption">待机眨眼、录音嘴形与情绪动作</view></view>
        <switch checked="{{draft.animation}}" bindchange="animationChanged" disabled="{{pending}}" aria-label="启用角色动画" />
      </view>
    </view>
    <view class="settings-actions">
      <button class="primary" bindtap="applySettings" loading="{{pending}}" disabled="{{!connected || pending || state === 'offline'}}">{{pending ? '等待开发板确认' : '应用到 OLED'}}</button>
      <button class="quiet" bindtap="restoreApplied" disabled="{{!appliedKnown || pending || !draftDirty}}">恢复设备当前设置</button>
    </view>
    <view class="footnote">修改先保留为草稿。只有收到开发板确认，才会显示已应用；确认后的设置由开发板保存。</view>
  </view>

  <view wx:if="{{historyEditor}}" class="correction-mask" catchtap="closeCorrection">
    <view class="correction-panel" catchtap="ignoreTap">
      <view class="panel-heading"><view class="panel-title">校对历史文字</view><button class="quiet small-button" bindtap="closeCorrection" disabled="{{historyEditor.saving}}">关闭</button></view>
      <view class="caption correction-help">保留原始识别文字。保存到电脑后，可分别推送原始版和校对版。</view>
      <textarea class="correction-input" value="{{historyEditor.draft}}" maxlength="1024" bindinput="inputCorrection" disabled="{{historyEditor.saving}}" cursor-spacing="40" aria-label="校对文字，最多512字及1536字节" />
      <view class="caption correction-count">{{historyEditor.counts.characters}} / 512 字 · {{historyEditor.counts.bytes}} / 1536 字节</view>
      <view class="correction-status {{historyEditor.conflict ? 'conflict' : ''}}" aria-role="status">{{historyEditor.status}}</view>
      <view class="correction-controls">
        <button class="primary" bindtap="saveCorrection" loading="{{historyEditor.saving}}" disabled="{{!connected || historyEditor.saving || historyEditor.conflict}}">保存校对</button>
        <button class="quiet" data-restore="{{true}}" bindtap="saveCorrection" disabled="{{!connected || !historyEditor.hasCorrection || historyEditor.saving || historyEditor.conflict}}">恢复原始</button>
        <button class="quiet" bindtap="reloadCorrection" disabled="{{historyEditor.saving}}">重新载入</button>
      </view>
      <view class="caption">保存与恢复不会自动推送 OLED，声音情绪仍来自原录音。发生版本冲突时先保留草稿，重新载入会替换当前草稿。</view>
    </view>
  </view>

  <view class="bottom-note">ESP32-S3 × INMP441 × FunASR</view>

  <view wx:if="{{showPrivacy}}" class="privacy-mask" catchtap="rejectPrivacy">
    <view class="privacy-panel" catchtap="ignoreTap">
      <view class="panel-title">扫码连接电脑</view>
      <view class="privacy-copy">扫码用于读取你电脑展示的配对信息。请阅读并同意<text class="privacy-link" bindtap="openPrivacy">{{privacyName}}</text>。也可以取消后手动填写连接信息。</view>
      <button id="voice-privacy-agree" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并扫码</button>
      <button class="quiet" bindtap="rejectPrivacy">手动填写</button>
    </view>
  </view>
</view>
